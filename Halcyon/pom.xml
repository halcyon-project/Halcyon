<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>Halcyon</artifactId>
    <version>1.1.0</version>
    <packaging>jar</packaging>
    <name>Halcyon</name>
    <parent>
        <groupId>com.ebremer.HalcyonProject</groupId>
        <artifactId>HalcyonProject</artifactId>
        <version>1.1.0</version>
    </parent>      
    <properties>
        <exec.longClasspath>true</exec.longClasspath>
    </properties>
    <build>
        <plugins>
            <plugin>
                <!-- mvn dependency:analyze -->
                <artifactId>maven-dependency-plugin</artifactId>
                <configuration>
                    <usedDependencies>
                        <dependency>org.apache.jena:jena-tdb2</dependency>
                   </usedDependencies>
                </configuration>
                <version>${maven-dependency-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>ban-log4j-slf4j-impl</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>org.apache.logging.log4j:log4j-slf4j-impl</exclude>
                                        <exclude>org.apache.logging.log4j:log4j-slf4j2-impl</exclude>
                                    </excludes>
                                    <message>Found Log4j2 SLF4J binding! This conflicts with Logback. Add exclusions to remove it.</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin> 
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>${jpackage-maven-plugin.version}</version>
                <configuration>
                    <name>Halcyon</name>
                    <appVersion>${project.version}</appVersion>
                    <vendor>Stony Brook University - Biomedical Informatics</vendor>
                    <copyright>Copyright 2021-2025 Erich Bremer - Stony Brook University</copyright>
                    <licenseFile>..\LICENSE</licenseFile>
                    <input>target</input>
                    <mainJar>Halcyon-${project.version}.jar</mainJar>
                    <verbose>true</verbose>
                    <description>Whole Slide Imaging and Feature Management</description>
                    <icon>src\main\resources\META-INF\halcyon.ico</icon>
                    <destination>dist</destination>
                    <javaOptions>
                        <option>-Dfile.encoding=UTF-8</option>
                        <!-- dcm4che's OpenCV codec (DICOMImageReader) reflects into JDK
                             internals to read frames directly off the file. -->
                        <option>--add-opens=java.base/java.io=ALL-UNNAMED</option>
                        <option>--add-opens=java.desktop/javax.imageio.stream=ALL-UNNAMED</option>
                    </javaOptions>
                </configuration>
                <executions>
                    <execution>
                        <id>win</id>
                        <configuration>
                            <installDir>\Halcyon</installDir>
                            <winMenu>true</winMenu>
                            <winShortcutPrompt>true</winShortcutPrompt>
                            <winDirChooser>true</winDirChooser>
                            <winConsole>true</winConsole>
                            <winHelpUrl>https://github.com/halcyon-project/Halcyon</winHelpUrl>
                            <winUpdateUrl>https://github.com/halcyon-project/Halcyon</winUpdateUrl>
                            <type>MSI</type>
                        </configuration>
                    </execution>
                    <execution>
                        <id>mac</id>
                        <configuration>
                            <installDir>/Applications</installDir>
                            <type>DMG</type>
                            <icon>src/main/resources/META-INF/halcyon.icns</icon>
                        </configuration>
                    </execution>
                    <execution>
                        <id>ubuntu</id>
                        <configuration>
                            <installDir>/usr/local</installDir>
                            <type>DEB</type>
                        </configuration>
                    </execution>
                    <execution>
                        <id>rhel</id>
                        <configuration>
                            <installDir>/usr/local</installDir>
                            <type>RPM</type>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <filtering>false</filtering>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <filtering>false</filtering>
                <directory>src/main/java</directory>
                <includes>
                    <include>**</include>
                </includes>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </resource>
        </resources>
    </build>  
    <profiles>
        <profile>
            <id>jar</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <finalName>Halcyon-${project.version}</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>enforce</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <banDuplicatePomDependencyVersions/>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>com.ebremer.halcyon.server.Main</mainClass>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>repackage</goal>
                                </goals>
                            </execution>
                        </executions>
                        <version>${springboot.version}</version>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${springboot.version}</version>
                        <configuration>
                            <image>
                                <builder>paketobuildpacks/builder:tiny</builder>
                                    <env>
                                        <BP_NATIVE_IMAGE>true</BP_NATIVE_IMAGE>
                                    </env>
                            </image>
                        </configuration>                        
                        <executions>
                            <execution>
                                <id>process-aot</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                        </executions>            
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <skip>false</skip>
                            <imageName>halcyon</imageName>
                            <fallback>true</fallback>
                            <agent>
                                <enabled>true</enabled>
                                <metadataCopy>
                                    <disabledStages>
                                        <stage>main</stage>
                                    </disabledStages>
                                    <merge>true</merge>
                                    <outputDirectory>src/test/resources/META-INF/native-image</outputDirectory>
                                </metadataCopy>
                            </agent>
                            <mainClass>com.ebremer.halcyon.server.Main</mainClass>
                                <debug>true</debug>
                                <skipNativeTests>true</skipNativeTests>
                                <verbose>true</verbose>
                                <buildArgs>
                                    <buildArg>-H:GenerateDebugInfo=0</buildArg>
                                    <buildArg>--enable-url-protocols=https</buildArg>
                                    <buildArg>-H:+AddAllCharsets</buildArg>
                                    <buildArg>--exact-reachability-metadata</buildArg>
                                    <buildArg>--report-unsupported-elements-at-runtime</buildArg>
                                    <buildArg>-H:IncludeResources=defaultapplication.yml</buildArg>
                                    <buildArg>-H:IncludeResources=defaultkeycloak-realm-config.json</buildArg>
                                    <buildArg>-H:IncludeResources=defaultkeycloak.json</buildArg>
                                </buildArgs>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.3</version>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
