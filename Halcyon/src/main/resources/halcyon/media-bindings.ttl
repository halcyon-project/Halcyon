@prefix dash: <http://datashapes.org/dash#> .
@prefix vg:   <urn:vandegraph:ns:> .
@prefix hal:  <https://halcyon.is/ns/> .
@prefix zeph: <https://halcyon.is/zephyr/ns/> .

# Halcyon's overlay on the vandegraph default media bindings — this file is
# where the default viewer/editor per media type is specified, and where
# alternates are listed. Exact media type beats the defaults' image/*
# pattern, so whole-slide TIFFs open in Zephyr while ordinary images keep
# the plain <img> viewer (which stays offered as an alternate here).

hal:WholeSlideImageBinding a vg:MediaBinding ;
    vg:mediaType "image/tiff" ;
    dash:viewer hal:ZephyrViewer ;
    vg:alternateViewers ( vg:HtmlImageViewer ) ;
    dash:editor hal:ZephyrEditor .

# BeakGraph feature sets (HDF5): no browser renders these, but Halcyon's IIIF
# engine does (BeakGraphImageReader tiles them), so they open in Zephyr, which
# seeds the file as a feature layer of a fresh stack and pulls those tiles.
# Both recorded spellings of the HDF media type are bound.
hal:BeakGraphBinding a vg:MediaBinding ;
    vg:mediaType "application/x-hdf5" , "application/x-hdf" ;
    dash:viewer hal:ZephyrViewer ;
    dash:editor hal:ZephyrEditor .

# Turtle that IS a Zephyr stack opens as that stack. CONJUNCTIVE on purpose:
# both the format and the scanner-discovered zeph:Stack type must hold, which
# is what lets this outrank the defaults' text/* source view (it ranks as an
# exact media match) without stealing plain Turtle documents — an untyped or
# not-yet-scanned .ttl keeps the text view, with Zephyr appearing only once
# the type is known.
hal:ZephyrStackBinding a vg:MediaBinding ;
    vg:mediaType "text/turtle" ;
    vg:rdfType zeph:Stack ;
    dash:viewer hal:ZephyrViewer ;
    dash:editor hal:ZephyrEditor .

# Stored HTML renders as a page by default — safely. Every layer forces the
# document inert: the LWS storage and the preview relay both answer
# scriptable types with `Content-Security-Policy: sandbox`, and the viewer's
# iframe carries sandbox="" besides — a unique opaque origin, no script,
# never this site. The source view stays one click away, and the TipTap
# document editor (etag-guarded PUT back to the storage) is the bound editor.
hal:HtmlPageBinding a vg:MediaBinding ;
    vg:mediaType "text/html" ;
    dash:viewer hal:HtmlPageViewer ;
    vg:alternateViewers ( vg:HtmlTextViewer ) ;
    dash:editor hal:HtmlPageEditor .

# XHTML renders the same sandboxed way, but is deliberately NOT editable:
# TipTap serializes HTML, which is not guaranteed to be the well-formed XML
# an application/xhtml+xml document must remain.
hal:XhtmlPageBinding a vg:MediaBinding ;
    vg:mediaType "application/xhtml+xml" ;
    dash:viewer hal:HtmlPageViewer ;
    vg:alternateViewers ( vg:HtmlTextViewer ) .
